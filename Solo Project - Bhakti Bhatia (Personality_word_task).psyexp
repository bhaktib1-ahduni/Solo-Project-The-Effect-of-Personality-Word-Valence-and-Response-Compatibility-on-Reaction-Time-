        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="PARTICIPANT INSTRUCTIONS&amp;#10;&amp;#10;&amp;#10;&amp;#10;Welcome to the experiment!&amp;#10;&amp;#10;&amp;#10;&amp;#10;You will see personality-related words appearing on either the LEFT or RIGHT side of the screen.&amp;#10;&amp;#10;&amp;#10;&amp;#10;Each trial will display one of two response rules:&amp;#10;&amp;#10;&amp;#10;&amp;#10;SAME SIDE: Press the arrow key on the same side as the word.&amp;#10;&amp;#10;&amp;#10;&amp;#10;OPPOSITE SIDE: Press the arrow key on the opposite side from the word.&amp;#10;&amp;#10;&amp;#10;&amp;#10;Please respond as quickly and accurately as possible.&amp;#10;&amp;#10;&amp;#10;&amp;#10;Press SPACE to begin." valType="str" updates="constant" name="text"/>
